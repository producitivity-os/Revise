{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revise",
  "version": "0.1.0",
  "identifier": "com.productivity-os.revise",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["productivity-revise"] } }
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Revise",
      "width": 1360,
      "height": 860,
      "minWidth": 980,
      "minHeight": 640,
      "decorations": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "visible": false,
      "trafficLightPosition": { "x": 14, "y": 17 }
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
